# Runtime
NODE_ENV=production
ENABLE_DEMO_ENDPOINTS=false

# VNPay Sandbox
VNPAY_ENABLED=true
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=<YOUR_SANDBOX_TMN_CODE>
VNPAY_HASH_SECRET=<YOUR_SANDBOX_HASH_SECRET>
VNPAY_RETURN_URL=http://localhost:5173/vnpay-return

# AI Artist Bio
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=