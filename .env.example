# TicketBox Docker Compose configuration
# Copy this file to .env in the repository root, then fill only the integrations you use.
# PostgreSQL, Redis, JWT, Mailpit and the mock gateway are configured internally by Compose.

# Runtime
NODE_ENV=production
ENABLE_DEMO_ENDPOINTS=false

# AI Artist Bio (optional; missing key uses the safe fallback)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# VNPay sandbox (set true only after filling a valid sandbox credential pair)
VNPAY_ENABLED=true
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/vnpay-return
