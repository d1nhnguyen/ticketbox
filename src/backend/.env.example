NODE_ENV=development
PORT=3000

# REQUIRED — app will refuse to start if missing

# Database (Postgres)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/ticketbox?schema=public"

# Cache & Queue (Redis)
REDIS_URL="redis://localhost:6379"

# JWT Auth  (min 15 chars in production, use a random secret!)
JWT_SECRET="super_secret_key_change_me_in_production"

# OPTIONAL — defaults are provided in code

JWT_EXPIRES_IN="7d"

# Mock Payment Gateway
MOCK_PAYMENT_URL="http://localhost:4000"
MOCK_PAYMENT_PORT=4000

# Circuit Breaker (opossum) — Cơ chế #3
CIRCUIT_BREAKER_TIMEOUT_MS=5000        # per-request timeout (ms)
CIRCUIT_BREAKER_ERROR_THRESHOLD=50     # % failures to open circuit
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000 # wait before HALF-OPEN (ms)
CIRCUIT_BREAKER_VOL_THRESHOLD=5        # min requests before % check

# Rate Limiting (Token Bucket) — Cơ chế #2
RATE_LIMIT_CAPACITY=100    # global max burst tokens
RATE_LIMIT_REFILL_RATE=10  # global tokens per second
PAYMENT_RATE_LIMIT_CAPACITY=20   # payment max burst tokens
PAYMENT_RATE_LIMIT_REFILL_RATE=2 # payment tokens per second

# AI Artist Bio — chọn provider qua AI_PROVIDER (anthropic | gemini | openai)
# Để trống AI_PROVIDER → dùng anthropic mặc định
# Nếu key không set → fallback template, không crash

AI_PROVIDER=gemini            # anthropic | gemini | openai

# Chỉ cần điền key của provider bạn đang dùng:
ANTHROPIC_API_KEY=            # sk-ant-api03-...   (provider: anthropic)
GEMINI_API_KEY=               # AIza...            (provider: gemini)
OPENAI_API_KEY=               # sk-...             (provider: openai)

# Model tùy chọn — mặc định theo provider nếu để trống:
#   anthropic → claude-haiku-4-5-20251001
#   gemini    → gemini-2.0-flash
#   openai    → gpt-4o-mini
AI_MODEL=                     # ví dụ: gemini-2.0-flash / claude-opus-4-5 / gpt-4o

# BullMQ / Notification email
MAIL_HOST="smtp.example.com"
MAIL_PORT=587
MAIL_USER="your_email"
MAIL_PASS="your_password"

# CSV ingestion schedule (cron syntax)
CSV_IMPORT_CRON="0 2 * * *"   # 2am daily

# VNPay Config (Sandbox)
VNPAY_ENABLED=false
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_RETURN_URL="http://localhost:5173/vnpay-return"

# CORS — comma-separated allowlist of origins permitted to call this API.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"

# Demo/debug endpoints (POST /payment/charge, /payment/reset, /debug/reminders/trigger).
# Must stay false/unset in the Docker/submission profile — only needed locally
# to run scripts/load-test/circuit-breaker.js and test-reminder-cron.js.
ENABLE_DEMO_ENDPOINTS=false
